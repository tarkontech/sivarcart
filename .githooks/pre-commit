#!/bin/sh
#
# Revisa el formato de los archivos PHP que se van a commitear.

root=$(git rev-parse --show-toplevel) || exit 1

cd "$root" || exit 1

files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.php$')

if [ -z "$files" ]; then
    exit 0
fi

if ! php vendor/bin/pint --test $files; then
    printf '\nEl formato no cumple. Ejecuta "composer lint" y vuelve a commitear.\n' >&2
    exit 1
fi
