parameters:
    level: 7
    paths:
        - src
        - config
        - database
        - routes
        - tools
        # The workbench plays the role of the host application, so it holds
        # the model that uses the trait of the roles of the store. Without it
        # PHPStan reports that trait as never used.
        - workbench
    excludePaths:
        # The compiled views of the workbench are build artifacts. The "?" marks
        # the path as optional: the directory is a build artifact of the
        # workbench and it does not exist on a fresh checkout, and PHPStan
        # refuses to run when an excluded path is missing.
        - workbench/storage (?)
    tmpDir: build/phpstan
    # Larastan reads the migrations of the host application to know the columns
    # of every table. A package ships its own migrations, so the path has to
    # be pointed at them explicitly.
    databaseMigrationsPath:
        - database/migrations
    # The models of this package declare their casts in the casts() method, so
    # Larastan has to parse it to know that an attribute is an enum and not a
    # plain string.
    parseModelCastsMethod: true
