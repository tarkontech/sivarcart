{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tarkontech/sivarcart-core",
    "description": "Tienda en linea para comercios de El Salvador",
    "keywords": [
        "laravel",
        "tarkontech",
        "sivarcart-core"
    ],
    "homepage": "https://github.com/tarkontech/sivarcart-core",
    "license": "MIT",
    "authors": [
        {
            "name": "Ronald Miranda",
            "email": "ronaldmirandasv@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3.36",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^12.0||^13.0",
        "rmirandasv/laravel-wompi": "^2.0",
        "spatie/laravel-medialibrary": "^11.23"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "laravel/pao": "^1.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "SivarcartCore\\SivarcartCore\\": "src/",
            "SivarcartCore\\SivarcartCore\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SivarcartCore\\SivarcartCore\\Tests\\": "tests/",
            "SivarcartCore\\SivarcartCore\\Tools\\": "tools/src/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@clear",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ],
        "hooks:install": [
            "@php tools/bin/install-hooks.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "SivarcartCore\\SivarcartCore\\SivarcartCoreServiceProvider"
            ],
            "aliases": {
                "SivarcartCore": "SivarcartCore\\SivarcartCore\\Facades\\SivarcartCore"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
