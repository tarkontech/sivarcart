{
    "name": "@tarkontech/sivarcart-core-admin",
    "description": "El panel de administración y la tienda de SivarCart Core, en React.",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run build:admin && npm run build:storefront",
        "build:admin": "vite build",
        "build:storefront": "vite build --config vite.storefront.config.ts",
        "dev": "vite build --watch",
        "dev:storefront": "vite build --config vite.storefront.config.ts --watch",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@inertiajs/react": "^3.11.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.80.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.1"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^26.6.10",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.3.0",
        "tailwindcss": "^4.3.5",
        "typescript": "^5.9.0",
        "vite": "^8.3.8"
    }
}
